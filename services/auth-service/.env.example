# Copy this file to .env and replace the placeholder values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4001

# --- Database (MySQL, auth_db — owned only by this service) ---
# Inside Docker use DB_HOST=auth-db. When running with `npm run dev` on your machine,
# the database container is not published to the host, so run MySQL locally and use localhost.
DB_HOST=auth-db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=auth_db

# --- Tokens ---
# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Passwords & account lockout ---
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- First SUPER_ADMIN account (read only by `npm run seed`) ---
# Leave these blank here; fill them in your own .env. Password: at least 12 characters.
SEED_TENANT_ID=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
