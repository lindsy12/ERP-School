{
  "name": "hr-service",
  "version": "1.0.0",
  "description": "Administration & HR microservice — School ERP (SEN4121)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --runInBand",
    "dev-token": "node scripts/dev-token.js",
    "seed": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupAfterEnv.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
