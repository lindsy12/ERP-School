# Copy this file to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# --- Downstream services (Docker service names; only reachable inside the compose network) ---
AUTH_SERVICE_URL=http://auth-service:4001
ACADEMIC_SERVICE_URL=http://academic-service:4002
FINANCE_SERVICE_URL=http://finance-service:4003
HR_SERVICE_URL=http://hr-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005

# --- Proxy behaviour ---
# Give up on a service that sends nothing back for this long, and answer 504.
PROXY_TIMEOUT_MS=10000
# How long GET /health waits for each service's own /health before calling it "down".
HEALTH_TIMEOUT_MS=2000
# How long to wait for auth-service's GET /api/v1/auth/verify before answering 503.
VERIFY_TIMEOUT_MS=3000

# --- CORS ---
# Browser origins allowed to call the gateway, comma-separated. Empty = no cross-origin access.
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting (not implemented yet) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
